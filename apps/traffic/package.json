{
  "name": "@ratewatch/traffic",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "traffic",
    "tags": [
      "scope:traffic"
    ],
    "targets": {
      "simulate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "artillery run simulate.yml",
          "cwd": "{projectRoot}",
          "env": {
            "ARTILLERY_DISABLE_TELEMETRY": "true"
          }
        }
      },
      "load": {
        "executor": "nx:run-commands",
        "options": {
          "command": "artillery run load.yml --output load-report.json && node build-load-report.js && prettier --write ../docs/src/content/docs/architecture/load-test-results.md",
          "cwd": "{projectRoot}",
          "env": {
            "ARTILLERY_DISABLE_TELEMETRY": "true"
          }
        }
      },
      "load-report": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node build-load-report.js && prettier --write ../docs/src/content/docs/architecture/load-test-results.md",
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
