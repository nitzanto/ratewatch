{
  "name": "@ratewatch/traffic",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "traffic",
    "tags": [
      "scope:traffic"
    ],
    "targets": {
      "simulate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "artillery run simulate.yml",
          "cwd": "{projectRoot}",
          "env": {
            "ARTILLERY_DISABLE_TELEMETRY": "true"
          }
        }
      }
    }
  }
}
